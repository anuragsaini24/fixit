NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/fixit
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
VITE_API_URL=/api
# Optional SMTP settings for booking and completion email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
# Password reset expiry in minutes (configured in the next auth-hardening step).
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=20
AGENT_SESSION_TTL_MINUTES=30
# Optional auth requests per IP per 15-minute window (defaults: 100 in development, 30 in production).
# AUTH_RATE_LIMIT=100
# Optional OpenAI-compatible chat completions endpoint. Leave unset to use keyword fallback.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
ADMIN_NAME=FixIt Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password